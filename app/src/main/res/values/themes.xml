<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Annem" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <!-- Gökçe Bilir: saydam pencere; uygulama telefonun ana ekranının üstünde cam bir çekmecede açılır. -->
    <style name="Theme.Gokce" parent="Theme.Annem">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <color name="cream">#FFF6EA</color>
    <color name="icon_bg">#1F6FA8</color>
</resources>
